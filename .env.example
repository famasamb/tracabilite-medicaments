# Copiez ce fichier en ".env" (meme dossier) et remplissez les valeurs. Le fichier .env ne doit JAMAIS etre ajoute a Git.
# Il est lu automatiquement au demarrage du serveur (une variable deja definie dans PowerShell est prioritaire).

# Adresse de base de l'application, utilisee dans les liens des e-mails
# (https://...trycloudflare.com pendant les tests sur telephone, le vrai domaine ensuite)
URL_PUBLIQUE=http://localhost:8000

# Serveur d'envoi des e-mails (SMTP). Exemple Gmail: smtp.gmail.com, port 587, mot de passe d'application.
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=votre.adresse@gmail.com
SMTP_MOT_DE_PASSE=mot-de-passe-d-application-sans-espaces
# Facultatif: adresse et nom affiches comme expediteur
# SMTP_EXPEDITEUR=noreply@votre-domaine.sn
# SMTP_NOM_EXPEDITEUR=Traçabilité des médicaments
# SMTP_SECURISE=starttls   (ou ssl pour le port 465)

# En production, une longue valeur aleatoire pour signer les sessions
# CLE_SECRETE=
